# Godot 4 .gitignore for Coralia

# Godot-specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (auto-generated from CSV)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System / Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
build/
dist/
*.apk
*.aab
*.ipa

# Sensitive files (NEVER commit)
*.keystore
*.jks
release.keystore
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
firebase_credentials.json
.env
.env.local
secrets.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.old
