# Coralia — .gitignore

# Unity builds (large binaries)
builds/
coralia/Assets/_Recovery/

# Unity generated
coralia/[Ll]ibrary/
coralia/[Tt]emp/
coralia/[Oo]bj/
coralia/[Bb]uild/
coralia/[Bb]uilds/
coralia/Logs/
coralia/UserSettings/
coralia/*.suo
coralia/*.user
coralia/*.pidb
coralia/*.booproj
coralia/sysinfo.txt
coralia/crashlytics-build.properties

# Godot (legacy)
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (auto-generated from CSV)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System / Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Large design source files (guardar en Drive/Dropbox)
*.psd
*.ai
*.sketch
*.fig

# Build artifacts
build/
dist/
*.apk
*.aab
*.ipa

# Sensitive files (NEVER commit)
*.keystore
*.jks
release.keystore
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
firebase_credentials.json
.env
.env.local
secrets.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.old
/.editor_settings
/.internal
/build